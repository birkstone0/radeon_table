# TablePH VIP Console - Frontend Environment Template
#
# Copy this file to .env in the frontend directory and fill in the actual values.
# Never commit populated .env files to version control.
#
# Vite exposes VITE_ prefixed variables to browser code, so these must NOT
# contain secrets (no passwords, API keys, database URIs, etc.).

# API base URL for the backend
# Development: use "/api" so the Vite dev proxy handles the request
# Production: use the deployed HTTPS API URL
VITE_API_BASE_URL=/api

# Production backend URL (for Netlify deployment)
# Uncomment and set this when deploying to production
# VITE_API_BASE_URL=https://radeon-table.onrender.com/api