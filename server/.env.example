# TablePH VIP Console - Backend Environment Template
#
# Copy this file to .env in the server directory and fill in the actual values.
# Never commit populated .env files to version control.
# This file is placeholders only - no real credentials.

# MongoDB connection string (required)
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Server port
PORT=8787

# Environment (development or production)
NODE_ENV=development

# Session secret (required in production - use a long random string)
SESSION_SECRET=replace_with_a_long_random_secret

# Session configuration
SESSION_MAX_AGE_MS=43200000

# Cookie security (set to 'true' in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origin (used for CORS when the API and web app are served separately)
# For single-origin deployment, leave empty
CLIENT_ORIGIN=

# Login rate limiting
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=10

# Initial administrator account (provisioned once on first boot)
ADMIN_USERNAME=<admin_username>
ADMIN_INITIAL_PASSWORD=<change_this_admin_password>

# Initial regular user account (provisioned once on first boot)
MEMBER_USERNAME=<member_username>
MEMBER_INITIAL_PASSWORD=<change_this_member_password>

# Credential TTL (in-memory store for imported account passwords)
CREDENTIAL_TTL_MS=21600000